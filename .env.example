# Copy to .env (git-ignored) and fill in. Keys are read by the backend only; never prefix any of
# these with VITE_ or the frontend build will ship them to the browser.
GEMINI_API_KEY=
# GOV.UK replacement API bearer token (legacy email/key are no longer used).
EPC_API_TOKEN=
EPC_API_EMAIL=
EPC_API_KEY=
MONGODB_URI=
GOOGLE_SOLAR_API_KEY=
